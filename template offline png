<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script src="https://aframe.io/releases/1.5.0/aframe.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/mind-ar@1.2.5/dist/mindar-image-aframe.prod.js"></script>
    <style>
        body { margin: 0; overflow: hidden; background: #000; }
        #gate { position: absolute; z-index: 999; }
    </style>
</head>
<body>
    <script>
        const PASS = "1234";
        window.addEventListener('load', () => {
            if (prompt("Password:") !== PASS) window.location.href = "https://google.com";
        });
    </script>

    <a-scene mindar-image="imageTargetSrc: ./targets.mind; autoStart: true; uiLoading: no;" vr-mode-ui="enabled: false">
        <a-assets>
            <img id="myPhoto" src="./overlay.png" crossorigin="anonymous"> png name from
        </a-assets>
        <a-camera position="0 0 0" look-controls="enabled: false"></a-camera>
        <a-entity id="target" mindar-image-target="targetIndex: 0">
            <a-image src="#myPhoto" width="1" height="1" position="0 0 0.1"></a-image>
        </a-entity>
    </a-scene>
</body>
</html>
